CHAINLINK_ETH_USD=0x4aDC67d868Ec4f4cD97E5c0a150AE3e2DB505D65
CHAINLINK_LINK_USD=0xb113F5A928BCfF189C998ab20d753a47F9dE5A61

# ── Post-Deployment (fill after deploying) ──
HOOK_ADDRESS=
SWAP_ROUTER=

# ── Arc Testnet (chain id 5042002) ──
# Arc uses USDC as the native gas token — fund the deployer with testnet USDC
# from https://faucet.circle.com (no ETH required).
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Canonical Circle tokens on Arc testnet (for reference; DeployArc deploys mocks):
#   USDC   = 0x3600000000000000000000000000000000000000 (6 decimals)
#   EURC   = 0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a (6 decimals)
# Post-deployment (fill after running script/DeployArc.s.sol):
ARC_POOL_MANAGER=
ARC_HOOK_ADDRESS=
ARC_USDC=
ARC_CIRBTC=
ARC_SWAP_ROUTER=
